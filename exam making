<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>시험 문제 출제해보기</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FAF9F4;
    --ink:#201F1C;
    --ink-soft:#5B5750;
    --rule:#C9C2AF;
    --rule-soft:#E3DECF;
    --stamp:#2B3A55;
    --stamp-soft:#EAEEF4;
    --mark:#9C2B2B;
    --mark-soft:#F3E1DF;
    --canvas-bg:#FFFFFF;
    --font-serif:'Noto Serif KR', 'Nanum Myeongjo', serif;
    --font-sans:'Noto Sans KR', -apple-system, BlinkMacSystemFont, 'Malgun Gothic', sans-serif;
  }
  *{ box-sizing:border-box; }
  html,body{
    margin:0; padding:0;
    background:#E9E6DC;
    font-family:var(--font-sans);
    color:var(--ink);
    -webkit-text-size-adjust:100%;
  }
  button, input, textarea, select{ font-family:inherit; }

  /* ---------- 선택 화면 ---------- */
  #selectScreen{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:32px 16px;
  }
  .select-inner{
    max-width:720px;
    width:100%;
  }
  .select-eyebrow{
    font-size:13px;
    color:var(--stamp);
    font-weight:600;
    letter-spacing:0.02em;
    margin-bottom:8px;
  }
  .select-title{
    font-family:var(--font-serif);
    font-size:clamp(28px, 5vw, 40px);
    font-weight:700;
    margin:0 0 12px;
    line-height:1.3;
  }
  .select-desc{
    color:var(--ink-soft);
    font-size:15px;
    line-height:1.7;
    margin:0 0 32px;
    max-width:56ch;
  }
  .type-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
    margin-bottom:28px;
  }
  @media (max-width:600px){
    .type-grid{ grid-template-columns:1fr; }
  }
  .type-card{
    text-align:left;
    background:var(--paper);
    border:1.5px solid var(--rule);
    padding:22px 20px;
    cursor:pointer;
    transition:border-color .15s ease, background .15s ease;
    display:flex;
    flex-direction:column;
    gap:10px;
    min-height:180px;
  }
  .type-card:hover, .type-card:focus-visible{
    border-color:var(--stamp);
    outline:none;
  }
  .type-card.selected{
    border-color:var(--mark);
    background:var(--mark-soft);
  }
  .type-card .type-tag{
    font-size:12px;
    font-weight:600;
    color:var(--stamp);
    background:var(--stamp-soft);
    display:inline-block;
    padding:3px 8px;
    width:fit-content;
  }
  .type-card.selected .type-tag{
    color:var(--mark);
    background:#fff;
  }
  .type-card h3{
    font-family:var(--font-serif);
    font-size:19px;
    margin:0;
    line-height:1.4;
  }
  .type-card p{
    font-size:13.5px;
    color:var(--ink-soft);
    line-height:1.6;
    margin:0;
  }
  .type-card .sample{
    font-size:12.5px;
    color:var(--ink-soft);
    border-top:1px dashed var(--rule);
    padding-top:9px;
    margin-top:auto;
  }
  .go-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:var(--stamp);
    color:#fff;
    border:none;
    padding:13px 26px;
    font-size:15px;
    font-weight:600;
    cursor:pointer;
    transition:opacity .15s ease;
  }
  .go-btn:disabled{ opacity:.35; cursor:not-allowed; }
  .go-btn:not(:disabled):hover{ opacity:.88; }

  /* ---------- 워크시트 화면 ---------- */
  #worksheetScreen{ display:none; }
  .toolbar{
    position:sticky; top:0; z-index:50;
    background:#1E2430;
    color:#fff;
    padding:10px 14px;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    align-items:center;
    justify-content:space-between;
  }
  .toolbar-left{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .toolbar-badge{
    font-size:12px;
    background:rgba(255,255,255,.12);
    padding:4px 10px;
    font-weight:600;
  }
  .toolbar button{
    border:1px solid rgba(255,255,255,.35);
    background:transparent;
    color:#fff;
    padding:8px 13px;
    font-size:13px;
    cursor:pointer;
    white-space:nowrap;
  }
  .toolbar button.primary{
    background:#fff;
    color:#1E2430;
    border-color:#fff;
    font-weight:700;
  }
  .toolbar button:active{ opacity:.7; }

  .page-outer{
    padding:28px 10px 60px;
    display:flex;
    justify-content:center;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
  }
  .page-scale-wrap{ flex-shrink:0; }
  .page{
    width:210mm;
    min-height:297mm;
    background:var(--paper);
    padding:16mm 15mm;
    box-shadow:0 4px 22px rgba(0,0,0,.18);
  }

  .sheet-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    border-bottom:2.5px solid var(--ink);
    padding-bottom:12px;
    margin-bottom:18px;
  }
  .sheet-header h1{
    font-family:var(--font-serif);
    font-size:24px;
    margin:0 0 4px;
  }
  .sheet-header .sub{
    font-size:12px;
    color:var(--ink-soft);
  }
  .id-fields{
    display:flex;
    gap:14px;
    font-size:12.5px;
  }
  .id-fields label{
    display:flex; flex-direction:column; gap:4px;
    color:var(--ink-soft);
  }
  .id-fields input{
    border:none;
    border-bottom:1px solid var(--ink);
    background:transparent;
    font-size:13.5px;
    padding:2px 2px 3px;
    width:100px;
    color:var(--ink);
  }
  .id-fields input:focus{ outline:none; border-bottom-color:var(--mark); }

  .field-block{ margin-bottom:16px; }
  .field-label{
    font-size:12px;
    font-weight:700;
    color:var(--stamp);
    letter-spacing:.02em;
    margin-bottom:7px;
    display:flex;
    align-items:center;
    gap:8px;
    justify-content:space-between;
  }
  .q-stem-row{ display:flex; gap:8px; }
  .q-num{
    font-family:var(--font-serif);
    font-weight:700;
    font-size:17px;
    padding-top:8px;
  }
  textarea.stem{
    flex:1;
    resize:vertical;
    min-height:56px;
    border:1px solid var(--rule);
    background:#fff;
    padding:9px 11px;
    font-size:14.5px;
    line-height:1.7;
    font-family:var(--font-sans);
    color:var(--ink);
  }
  textarea.stem:focus{ outline:none; border-color:var(--stamp); }

  .data-box{
    border:1px solid var(--rule);
    background:#fff;
  }
  .data-box-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:8px 10px;
    border-bottom:1px solid var(--rule-soft);
    background:#F4F2EA;
  }
  .data-box-head .label{ font-size:12px; font-weight:700; color:var(--ink-soft); }
  .mode-toggle{ display:flex; gap:6px; }
  .mode-toggle button{
    font-size:12px;
    padding:6px 10px;
    border:1px solid var(--rule);
    background:#fff;
    cursor:pointer;
    color:var(--ink-soft);
  }
  .mode-toggle button.active{
    background:var(--stamp);
    border-color:var(--stamp);
    color:#fff;
  }
  .data-box-body{ padding:10px; }
  .draw-tools{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:8px;
    flex-wrap:wrap;
    font-size:12px;
    color:var(--ink-soft);
  }
  .draw-tools label{ display:flex; align-items:center; gap:5px; }
  .draw-tools input[type=color]{ width:28px; height:28px; border:1px solid var(--rule); padding:0; background:none; cursor:pointer; }
  .draw-tools input[type=range]{ width:90px; }
  .draw-tools button{
    border:1px solid var(--rule);
    background:#fff;
    padding:6px 11px;
    cursor:pointer;
    font-size:12px;
  }
  canvas.draw-canvas{
    width:100%;
    height:auto;
    display:block;
    background:var(--canvas-bg);
    border:1px dashed var(--rule);
    touch-action:none;
    cursor:crosshair;
  }
  .upload-panel{ text-align:center; padding:18px 10px; }
  .upload-panel img{
    max-width:100%;
    max-height:280px;
    display:block;
    margin:0 auto 10px;
    border:1px solid var(--rule-soft);
  }
  .upload-empty{
    padding:34px 10px;
    color:var(--ink-soft);
    font-size:13px;
    border:1px dashed var(--rule);
    margin-bottom:10px;
  }
  .file-btn{
    display:inline-block;
    border:1px solid var(--stamp);
    color:var(--stamp);
    background:#fff;
    padding:9px 16px;
    font-size:13px;
    cursor:pointer;
    font-weight:600;
  }
  .file-btn input{ display:none; }

  .box-label-tag{
    display:inline-block;
    font-family:var(--font-serif);
    font-weight:700;
    font-size:13px;
    border:1px solid var(--ink);
    padding:1px 9px;
    margin-bottom:8px;
  }
  .bogi-box{
    border:1px solid var(--rule);
    background:#fff;
    padding:12px 14px;
  }
  .bogi-row{
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom:8px;
  }
  .bogi-row:last-child{ margin-bottom:0; }
  .bogi-letter{
    font-family:var(--font-serif);
    font-weight:700;
    font-size:14px;
    width:20px;
    flex-shrink:0;
  }
  .bogi-row input{
    flex:1;
    border:none;
    border-bottom:1px solid var(--rule-soft);
    padding:6px 2px;
    font-size:13.5px;
    background:transparent;
    color:var(--ink);
  }
  .bogi-row input:focus{ outline:none; border-bottom-color:var(--stamp); }

  .choices{ margin-top:4px; }
  .choice-row{
    display:flex;
    align-items:center;
    gap:10px;
    padding:8px 2px;
    border-bottom:1px solid var(--rule-soft);
  }
  .choice-row:last-child{ border-bottom:none; }
  .circ-num{
    font-family:var(--font-serif);
    font-size:16px;
    width:22px;
    flex-shrink:0;
    text-align:center;
  }
  .choice-row input[type=text]{
    flex:1;
    border:none;
    border-bottom:1px solid var(--rule-soft);
    padding:6px 4px;
    font-size:14px;
    background:transparent;
    color:var(--ink);
  }
  .choice-row input[type=text]:focus{ outline:none; border-bottom-color:var(--stamp); }
  .answer-pick{
    display:flex;
    align-items:center;
    gap:5px;
    font-size:11.5px;
    color:var(--ink-soft);
    flex-shrink:0;
  }
  .answer-pick input{ accent-color:var(--mark); width:15px; height:15px; }

  .footer-note{
    margin-top:22px;
    padding-top:10px;
    border-top:1px solid var(--rule-soft);
    font-size:10.5px;
    color:var(--ink-soft);
    display:flex;
    justify-content:space-between;
  }

  body.capturing .no-capture{ display:none !important; }

  @media (max-width:480px){
    .sheet-header{ flex-direction:column; gap:10px; }
    .id-fields{ align-self:flex-start; }
  }
</style>
</head>
<body>

<!-- ================= 1단계: 문제 유형 선택 ================= -->
<div id="selectScreen">
  <div class="select-inner">
    <div class="select-eyebrow">시험 문제 출제해보기</div>
    <h1 class="select-title">내가 직접 시험 문제를 만들어 볼까요?</h1>
    <p class="select-desc">먼저 만들고 싶은 문제 유형을 골라 보세요. 유형에 따라 자료를 넣는 방식과 선택지 구성이 달라집니다.</p>

    <div class="type-grid">
      <div class="type-card" id="cardImage" tabindex="0" role="button" aria-pressed="false">
        <span class="type-tag">유형 1</span>
        <h3>자료 제시형 &middot; 5지선다</h3>
        <p>그림이나 사진 같은 자료를 하나 제시하고, 5개의 선택지 중 정답을 고르는 문제예요.</p>
        <div class="sample">예) 그래프를 보고 옳은 설명 고르기</div>
      </div>
      <div class="type-card" id="cardCombo" tabindex="0" role="button" aria-pressed="false">
        <span class="type-tag">유형 2</span>
        <h3>자료 + &lt;보기&gt; 조합형</h3>
        <p>자료를 제시한 뒤 &lt;보기&gt;에 ㄱ~ㅁ 진술을 적고, 선택지에서 옳은 것을 몇 개씩 묶어 고르는 문제예요.</p>
        <div class="sample">예) &lt;보기&gt;에서 옳은 것을 모두 고른 것은?</div>
      </div>
    </div>

    <button class="go-btn" id="goBtn" disabled>선택한 유형으로 문제 만들기 →</button>
  </div>
</div>

<!-- ================= 2단계: 실제 학습지(A4) ================= -->
<div id="worksheetScreen">
  <div class="toolbar no-capture">
    <div class="toolbar-left">
      <button id="backBtn">← 유형 다시 선택</button>
      <span class="toolbar-badge" id="typeBadge">유형 미선택</span>
    </div>
    <button class="primary" id="pdfBtn">PDF로 저장하기</button>
  </div>

  <div class="page-outer">
    <div class="page-scale-wrap" id="scaleWrap">
      <div class="page" id="page">

        <div class="sheet-header">
          <div>
            <h1>시험 문제 출제해보기</h1>
            <div class="sub" id="typeSubLabel">문제 유형 : -</div>
          </div>
          <div class="id-fields">
            <label>학번<input type="text" id="studentNo" placeholder=""></label>
            <label>이름<input type="text" id="studentName" placeholder=""></label>
          </div>
        </div>

        <div class="field-block">
          <div class="field-label">문제 지문</div>
          <div class="q-stem-row">
            <div class="q-num">1.</div>
            <textarea class="stem" id="stemInput" placeholder="예) 다음 자료를 보고, 이에 대한 설명으로 옳은 것은?"></textarea>
          </div>
        </div>

        <div class="field-block">
          <div class="field-label">자료 입력</div>
          <div class="data-box">
            <div class="data-box-head">
              <span class="label">그림을 그리거나, 가지고 있는 파일을 추가하세요</span>
              <div class="mode-toggle no-capture">
                <button id="modeDrawBtn" class="active" type="button">✏ 직접 그리기</button>
                <button id="modeUploadBtn" type="button">📁 파일 추가</button>
              </div>
            </div>
            <div class="data-box-body">

              <div id="drawPanel">
                <div class="draw-tools no-capture">
                  <label>색<input type="color" id="penColor" value="#201F1C"></label>
                  <label>굵기<input type="range" id="penSize" min="1" max="14" value="3"></label>
                  <button id="clearCanvasBtn" type="button">지우기</button>
                </div>
                <canvas class="draw-canvas" id="drawCanvas" width="900" height="420"></canvas>
              </div>

              <div id="uploadPanel" style="display:none;">
                <div class="upload-empty" id="uploadEmpty">아직 추가된 파일이 없어요</div>
                <img id="uploadedImg" style="display:none;">
                <div class="no-capture">
                  <label class="file-btn">파일 선택
                    <input type="file" id="fileInput" accept="image/*">
                  </label>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- 유형2 전용: <보기> -->
        <div class="field-block" id="bogiBlock" style="display:none;">
          <span class="box-label-tag">보기</span>
          <div class="bogi-box">
            <div class="bogi-row"><span class="bogi-letter">ㄱ.</span><input type="text" placeholder="첫 번째 진술을 입력하세요"></div>
            <div class="bogi-row"><span class="bogi-letter">ㄴ.</span><input type="text" placeholder="두 번째 진술을 입력하세요"></div>
            <div class="bogi-row"><span class="bogi-letter">ㄷ.</span><input type="text" placeholder="세 번째 진술을 입력하세요"></div>
            <div class="bogi-row"><span class="bogi-letter">ㄹ.</span><input type="text" placeholder="네 번째 진술을 입력하세요"></div>
            <div class="bogi-row"><span class="bogi-letter">ㅁ.</span><input type="text" placeholder="다섯 번째 진술을 입력하세요"></div>
          </div>
        </div>

        <div class="field-block">
          <div class="field-label">
            <span id="choiceLabel">선택지</span>
            <span style="font-weight:400; color:var(--ink-soft); font-size:11px;" id="choiceHint"></span>
          </div>
          <div class="choices">
            <div class="choice-row"><span class="circ-num">①</span><input type="text" placeholder="선택지 1을 입력하세요"><span class="answer-pick"><input type="radio" name="answer"> 정답</span></div>
            <div class="choice-row"><span class="circ-num">②</span><input type="text" placeholder="선택지 2를 입력하세요"><span class="answer-pick"><input type="radio" name="answer"> 정답</span></div>
            <div class="choice-row"><span class="circ-num">③</span><input type="text" placeholder="선택지 3을 입력하세요"><span class="answer-pick"><input type="radio" name="answer"> 정답</span></div>
            <div class="choice-row"><span class="circ-num">④</span><input type="text" placeholder="선택지 4를 입력하세요"><span class="answer-pick"><input type="radio" name="answer"> 정답</span></div>
            <div class="choice-row"><span class="circ-num">⑤</span><input type="text" placeholder="선택지 5를 입력하세요"><span class="answer-pick"><input type="radio" name="answer"> 정답</span></div>
          </div>
        </div>

        <div class="footer-note">
          <span>시험 문제 출제해보기 활동지</span>
          <span id="footerType">-</span>
        </div>

      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
(function(){
  "use strict";

  var selectedType = null;
  var cardImage = document.getElementById('cardImage');
  var cardCombo = document.getElementById('cardCombo');
  var goBtn = document.getElementById('goBtn');

  function chooseCard(type){
    selectedType = type;
    cardImage.classList.toggle('selected', type === 'image');
    cardCombo.classList.toggle('selected', type === 'combo');
    cardImage.setAttribute('aria-pressed', type === 'image');
    cardCombo.setAttribute('aria-pressed', type === 'combo');
    goBtn.disabled = false;
  }
  cardImage.addEventListener('click', function(){ chooseCard('image'); });
  cardCombo.addEventListener('click', function(){ chooseCard('combo'); });
  [cardImage, cardCombo].forEach(function(card){
    card.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        card.click();
      }
    });
  });

  var selectScreen = document.getElementById('selectScreen');
  var worksheetScreen = document.getElementById('worksheetScreen');
  var typeBadge = document.getElementById('typeBadge');
  var typeSubLabel = document.getElementById('typeSubLabel');
  var footerType = document.getElementById('footerType');
  var bogiBlock = document.getElementById('bogiBlock');
  var choiceHint = document.getElementById('choiceHint');

  function enterWorksheet(){
    var label = selectedType === 'image' ? '자료 제시형 · 5지선다' : '자료 + <보기> 조합형';
    typeBadge.textContent = label;
    typeSubLabel.textContent = '문제 유형 : ' + label;
    footerType.textContent = label;
    bogiBlock.style.display = selectedType === 'combo' ? 'block' : 'none';
    choiceHint.textContent = selectedType === 'combo' ? '(보기의 ㄱ~ㅁ을 조합해 적어도 좋아요)' : '';
    selectScreen.style.display = 'none';
    worksheetScreen.style.display = 'block';
    window.scrollTo(0,0);
    requestAnimationFrame(fitPage);
  }
  goBtn.addEventListener('click', enterWorksheet);

  document.getElementById('backBtn').addEventListener('click', function(){
    if(!confirm('처음 화면으로 돌아가시겠어요? 입력한 내용은 사라지지 않고 그대로 남아 있어요.')) return;
    worksheetScreen.style.display = 'none';
    selectScreen.style.display = 'flex';
  });

  /* ---------- 반응형 스케일 ---------- */
  var scaleWrap = document.getElementById('scaleWrap');
  var page = document.getElementById('page');
  function fitPage(){
    var pageWidth = page.offsetWidth;
    if(!pageWidth) return;
    var available = window.innerWidth - 20;
    var scale = available < pageWidth ? (available / pageWidth) : 1;
    scale = Math.max(scale, 0.32);
    scaleWrap.style.transform = 'scale(' + scale + ')';
    scaleWrap.style.transformOrigin = 'top center';
    scaleWrap.style.width = pageWidth + 'px';
    scaleWrap.style.marginBottom = (page.offsetHeight * (scale - 1)) + 'px';
  }
  window.addEventListener('resize', fitPage);
  window.addEventListener('orientationchange', function(){ setTimeout(fitPage, 250); });

  /* ---------- 자료 입력 모드 전환 ---------- */
  var modeDrawBtn = document.getElementById('modeDrawBtn');
  var modeUploadBtn = document.getElementById('modeUploadBtn');
  var drawPanel = document.getElementById('drawPanel');
  var uploadPanel = document.getElementById('uploadPanel');

  modeDrawBtn.addEventListener('click', function(){
    modeDrawBtn.classList.add('active');
    modeUploadBtn.classList.remove('active');
    drawPanel.style.display = 'block';
    uploadPanel.style.display = 'none';
  });
  modeUploadBtn.addEventListener('click', function(){
    modeUploadBtn.classList.add('active');
    modeDrawBtn.classList.remove('active');
    uploadPanel.style.display = 'block';
    drawPanel.style.display = 'none';
  });

  /* ---------- 그리기 (포인터 이벤트로 아이패드 터치/펜슬 지원) ---------- */
  var canvas = document.getElementById('drawCanvas');
  var ctx = canvas.getContext('2d');
  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(0,0,canvas.width, canvas.height);
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';

  var drawing = false;
  var lastX = 0, lastY = 0;

  function getPos(evt){
    var rect = canvas.getBoundingClientRect();
    var scaleX = canvas.width / rect.width;
    var scaleY = canvas.height / rect.height;
    return {
      x: (evt.clientX - rect.left) * scaleX,
      y: (evt.clientY - rect.top) * scaleY
    };
  }

  canvas.addEventListener('pointerdown', function(evt){
    evt.preventDefault();
    canvas.setPointerCapture(evt.pointerId);
    drawing = true;
    var p = getPos(evt);
    lastX = p.x; lastY = p.y;
    ctx.beginPath();
    ctx.arc(p.x, p.y, ctx.lineWidth/2, 0, Math.PI*2);
    ctx.fillStyle = document.getElementById('penColor').value;
    ctx.fill();
  });
  canvas.addEventListener('pointermove', function(evt){
    if(!drawing) return;
    evt.preventDefault();
    var p = getPos(evt);
    ctx.strokeStyle = document.getElementById('penColor').value;
    ctx.lineWidth = document.getElementById('penSize').value;
    ctx.beginPath();
    ctx.moveTo(lastX, lastY);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    lastX = p.x; lastY = p.y;
  });
  function endStroke(evt){ drawing = false; }
  canvas.addEventListener('pointerup', endStroke);
  canvas.addEventListener('pointercancel', endStroke);
  canvas.addEventListener('pointerleave', endStroke);

  document.getElementById('clearCanvasBtn').addEventListener('click', function(){
    if(!confirm('그린 내용을 모두 지울까요?')) return;
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0,0,canvas.width, canvas.height);
  });

  /* ---------- 파일 업로드 ---------- */
  var fileInput = document.getElementById('fileInput');
  var uploadedImg = document.getElementById('uploadedImg');
  var uploadEmpty = document.getElementById('uploadEmpty');

  fileInput.addEventListener('change', function(evt){
    var file = evt.target.files && evt.target.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(e){
      uploadedImg.src = e.target.result;
      uploadedImg.style.display = 'block';
      uploadEmpty.style.display = 'none';
    };
    reader.readAsDataURL(file);
  });

  /* ---------- PDF 저장 (인쇄 대화상자 없이 바로 저장) ---------- */
  var pdfBtn = document.getElementById('pdfBtn');
  pdfBtn.addEventListener('click', function(){
    pdfBtn.disabled = true;
    var originalText = pdfBtn.textContent;
    pdfBtn.textContent = 'PDF 만드는 중...';

    document.body.classList.add('capturing');
    var prevTransform = scaleWrap.style.transform;
    scaleWrap.style.transform = 'none';

    setTimeout(function(){
      html2canvas(page, {
        scale: 2,
        useCORS: true,
        backgroundColor: '#FFFFFF'
      }).then(function(canvasResult){
        document.body.classList.remove('capturing');
        scaleWrap.style.transform = prevTransform;
        fitPage();

        var imgData = canvasResult.toDataURL('image/jpeg', 0.95);
        var jsPDF = window.jspdf.jsPDF;
        var pdf = new jsPDF('p', 'mm', 'a4');
        var pageW = pdf.internal.pageSize.getWidth();
        var pageH = pdf.internal.pageSize.getHeight();
        var imgH = (canvasResult.height * pageW) / canvasResult.width;

        var y = 0;
        if(imgH <= pageH){
          pdf.addImage(imgData, 'JPEG', 0, 0, pageW, imgH);
        } else {
          // 내용이 A4 한 장보다 길면 자동으로 나눠 담기
          var remaining = imgH;
          var srcY = 0;
          var pageCanvas = document.createElement('canvas');
          var pageCtx = pageCanvas.getContext('2d');
          var pxPerMm = canvasResult.width / pageW;
          pageCanvas.width = canvasResult.width;
          pageCanvas.height = pageH * pxPerMm;
          var first = true;
          while(remaining > 0){
            var sliceHeightPx = Math.min(pageCanvas.height, canvasResult.height - srcY);
            pageCanvas.height = sliceHeightPx;
            pageCtx.fillStyle = '#FFFFFF';
            pageCtx.fillRect(0,0,pageCanvas.width, pageCanvas.height);
            pageCtx.drawImage(canvasResult, 0, srcY, canvasResult.width, sliceHeightPx, 0, 0, canvasResult.width, sliceHeightPx);
            var sliceData = pageCanvas.toDataURL('image/jpeg', 0.95);
            var sliceHmm = sliceHeightPx / pxPerMm;
            if(!first) pdf.addPage();
            pdf.addImage(sliceData, 'JPEG', 0, 0, pageW, sliceHmm);
            srcY += sliceHeightPx;
            remaining -= sliceHmm;
            first = false;
          }
        }

        var name = (document.getElementById('studentName').value || '학생').trim();
        var fileName = name + '_시험문제출제.pdf';

        try{
          pdf.save(fileName);
        }catch(err){
          var blobUrl = pdf.output('bloburl');
          window.open(blobUrl, '_blank');
        }

        pdfBtn.disabled = false;
        pdfBtn.textContent = originalText;
      }).catch(function(err){
        document.body.classList.remove('capturing');
        scaleWrap.style.transform = prevTransform;
        fitPage();
        pdfBtn.disabled = false;
        pdfBtn.textContent = originalText;
        alert('PDF를 만드는 중 문제가 발생했어요. 잠시 후 다시 시도해 주세요.');
      });
    }, 60);
  });

  window.addEventListener('load', fitPage);
})();
</script>
</body>
</html>
